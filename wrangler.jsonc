{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-event-sourcing",
  "main": "dist/worker/worker-event-sourcing.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "LOG", "class_name": "Log" },
      { "name": "PROJECTION", "class_name": "Projection" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Log", "Projection"] }
  ]
}
