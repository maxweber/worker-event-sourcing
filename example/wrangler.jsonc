{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-event-sourcing-example",
  "main": "dist/worker/example.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "STREAM", "class_name": "Stream" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Stream"] }
  ]
}
